{
  "description": "Menu screen definitions. All positions in visual units. Colors reference data/colors.json by name. Borders reference data/borders.json by name. Label keys reference data/i18n strings.",
  "menu-defaults": {
    "overlay": {
      "background-color": "dark-black",
      "background-opacity": 0.9
    },
    "font-family": "'Comic Sans MS', 'Comic Sans', monospace",
    "title": {
      "font-family": "'Comic Sans MS', 'Comic Sans', monospace",
      "font-size": 0.6,
      "color": "white",
      "anchor": "top-center",
      "offset": { "x": 0, "y": 1.5 }
    },
    "subtitle": {
      "font-size": 0.35,
      "color": "dark-white",
      "anchor": "top-center",
      "offset": { "x": 0, "y": 2.3 }
    },
    "button": {
      "size": { "width": 3.5, "height": 0.55 },
      "gap": 0.15,
      "border": "thin",
      "border-color": "white",
      "corner-radius": 0.15,
      "fill-color": "dark-blue",
      "hover-fill-color": "blue",
      "selected-fill-color": "white",
      "selected-text-color": "black",
      "text-color": "white",
      "selected-prefix": "> ",
      "selected-suffix": " <",
      "default-prefix": "",
      "default-suffix": "",
      "font-size": 0.3,
      "anchor": "top-center"
    },
    "hint": {
      "font-size": 0.2,
      "color": "dark-white",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.5 }
    },
    "layout": {
      "title": { "offset-y": 2.0, "font-size-offset": 0.2 },
      "items": {
        "start-y": 4.2,
        "gap": 0.6,
        "selected-prefix": "> ",
        "selected-suffix": " <",
        "default-prefix": "",
        "default-suffix": ""
      },
      "rows": { "font-size": 0.45, "gap": 1.15 }
    }
  },
  "menus": {
    "title-screen": {
      "description": "Main title screen shown on game launch.",
      "title-key": "menu.main.title",
      "layout": "centered-vertical",
      "start-offset": { "x": 0, "y": 3.5 },
      "buttons": [
        { "label-key": "menu.main.start", "action": "start-game" },
        { "label-key": "menu.main.tutorial", "action": "tutorial" },
        { "label-key": "menu.main.settings", "action": "open-settings" },
        { "label-key": "menu.main.credits", "action": "show-credits" }
      ],
      "hint-key": null
    },
    "pause-menu": {
      "description": "Pause overlay shown when player presses pause during gameplay.",
      "title-key": "menu.pause.title",
      "overlay-opacity": 0.7,
      "layout": "centered-vertical",
      "start-offset": { "x": 0, "y": 3.0 },
      "layout-overrides": {
        "title": { "offset-y": 2.2 },
        "items": { "start-y": 3.0 }
      },
      "button": {
        "selected-text-color": "yellow",
        "text-color": "dark-white",
        "selected-prefix": "> ",
        "selected-suffix": "",
        "default-prefix": "  ",
        "default-suffix": ""
      },
      "buttons": [
        { "label-key": "menu.pause.resume", "action": "resume" },
        { "label-key": "menu.pause.settings", "action": "open-settings" },
        { "label-key": "menu.pause.restart-stage", "action": "restart-stage" },
        { "label-key": "menu.pause.quit-to-map", "action": "quit-to-map" },
        { "label-key": "menu.pause.quit-to-menu", "action": "quit-to-menu" }
      ],
      "hint-key": "input.pause-hint"
    },
    "settings": {
      "description": "Settings screen for audio and controls configuration.",
      "title-key": "menu.settings.title",
      "layout": "centered-vertical",
      "start-offset": { "x": 0, "y": 3.0 },
      "layout-overrides": {
        "title": { "offset-y": 1.5, "font-size-offset": 0.1 },
        "items": {
          "start-y": 3.0,
          "gap": 0.6,
          "selected-prefix": "> ",
          "selected-suffix": " <",
          "default-prefix": "",
          "default-suffix": ""
        },
        "rows": { "gap": 1.15 }
      },
      "sliders": [
        {
          "label-key": "menu.settings.music-volume",
          "setting-key": "bgm-volume",
          "min": 0.0,
          "max": 1.0,
          "step": 0.1,
          "track-size": { "width": 4.0, "height": 0.3 },
          "track-color": "dark-white",
          "fill-color": "blue",
          "thumb-radius": 0.2,
          "thumb-color": "white",
          "corner-radius": 0.1
        },
        {
          "label-key": "menu.settings.sfx-volume",
          "setting-key": "sfx-volume",
          "min": 0.0,
          "max": 1.0,
          "step": 0.1,
          "track-size": { "width": 4.0, "height": 0.3 },
          "track-color": "dark-white",
          "fill-color": "blue",
          "thumb-radius": 0.2,
          "thumb-color": "white",
          "corner-radius": 0.1
        }
      ],
      "buttons": [
        { "label-key": "menu.settings.controls", "action": "open-controls" },
        { "label-key": "menu.settings.back", "action": "back" }
      ],
      "hint-key": "input.navigate-hint"
    },
    "game-over": {
      "description": "Shown when the player runs out of lives and has no continues.",
      "title-key": "menu.game-over.title",
      "layout": "centered-vertical",
      "start-offset": { "x": 0, "y": 3.5 },
      "overlay-opacity": 1,
      "layout-overrides": {
        "title": { "offset-y": 2.5 },
        "items": { "start-y": 7.2 },
        "rows": {
          "font-size": 0.45,
          "continues": { "offset-y": 4.5 },
          "lives": { "offset-y": 5.3 },
          "continue-hint": { "offset-y": 6.0 }
        }
      },
      "buttons": [
        { "label-key": "menu.game-over.continue", "action": "continue", "visible-condition": "has-continues" },
        { "label-key": "menu.game-over.quit", "action": "quit-to-menu" }
      ],
      "hint-key": null
    },
    "stage-clear": {
      "description": "Shown after completing a stage. Displays fruit collected, new ability unlocked, and score.",
      "title-key": "menu.stage-clear.title",
      "layout": "centered-vertical",
      "start-offset": { "x": 0, "y": 3.0 },
      "overlay-opacity": 1,
      "layout-overrides": {
        "items": { "start-y": 8.8 },
        "rows": {
          "font-size": 0.4,
          "stage-name": { "offset-y": 3.5, "font-size": 0.5 },
          "fruit": { "offset-y": 4.5 },
          "ability": { "offset-y": 5.5 },
          "score": { "offset-y": 6.5 },
          "continue-hint": { "offset-y": 8.0 }
        }
      },
      "summary": {
        "fruit-label-key": "menu.stage-clear.fruit-collected",
        "ability-label-key": "menu.stage-clear.new-ability",
        "score-label-key": "hud.score",
        "fruit-icon-size": { "width": 1.0, "height": 1.0 },
        "font-size": 0.3,
        "color": "white",
        "detail-color": "yellow",
        "section-gap": 0.4
      },
      "buttons": [
        { "label-key": "menu.stage-clear.continue", "action": "continue-to-map" }
      ],
      "hint-key": null
    }
  },
  "info-screens": {
    "tutorial": {
      "description": "Read-only tutorial screen opened from the title menu.",
      "title-key": "menu.tutorial.title",
      "start-offset": { "x": 0, "y": 2.4 },
      "lines": [
        "menu.tutorial.line-1",
        "menu.tutorial.line-2",
        "menu.tutorial.line-3",
        "menu.tutorial.line-4",
        "menu.tutorial.line-5"
      ],
      "line": { "font-size": 0.28, "color": "white", "gap": 0.55 },
      "hint-key": "input.info-hint"
    },
    "show-credits": {
      "description": "Read-only credits screen opened from the title menu.",
      "title-key": "menu.credits.title",
      "start-offset": { "x": 0, "y": 2.4 },
      "lines": [
        "menu.credits.line-1",
        "menu.credits.line-2",
        "menu.credits.line-3",
        "menu.credits.line-4"
      ],
      "line": { "font-size": 0.28, "color": "white", "gap": 0.55 },
      "hint-key": "input.info-hint"
    },
    "open-controls": {
      "description": "Read-only controls listing opened from the settings screen.",
      "title-key": "menu.controls.title",
      "start-offset": { "x": 0, "y": 2.0 },
      "lines": [
        "menu.controls.line-1",
        "menu.controls.line-2",
        "menu.controls.line-3",
        "menu.controls.line-4",
        "menu.controls.line-5",
        "menu.controls.line-6",
        "menu.controls.line-7",
        "menu.controls.line-8"
      ],
      "line": { "font-size": 0.25, "color": "white", "gap": 0.45 },
      "hint-key": "input.info-hint"
    }
  }
}
